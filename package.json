{
  "name": "lwc-to-react-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "apex:facade": "node apex/generate-facade.js force-app/main/default/classes apex/generated",
    "census": "node census/run.js",
    "codemod": "jest codemod --silent=false",
    "corpus": "node census/run.js corpus/lwc-recipes && node codemod/generate.js corpus/lwc-recipes react/corpus",
    "fixtures:check": "jest fixtures --silent=false",
    "generate": "node codemod/generate.js",
    "learn": "node agent/learn.js",
    "learn:verify": "node agent/verify.js",
    "oracle": "jest oracle/normalise.test.js --silent=false",
    "preview": "vite",
    "setup": "npm ci --offline",
    "springboot": "node apex/generate-springboot.js",
    "styles": "node codemod/styles-report.js corpus/lwc-recipes",
    "test": "jest",
    "test:verbose": "jest --silent=false",
    "vendor:refresh": "npm ci --cache vendor/npm-cache --no-audit --no-fund"
  },
  "devDependencies": {
    "@apexdevtools/apex-parser": "file:vendor/apexdevtools-apex-parser-5.1.0.tgz",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@lwc/template-compiler": "8.28.2",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "@tanstack/react-query": "^5.101.4",
    "dom-accessibility-api": "^0.7.1",
    "fast-xml-parser": "^5.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  }
}
