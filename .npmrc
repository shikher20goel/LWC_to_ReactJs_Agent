# Offline-first install. The company network cannot reach the npm registry,
# so every dependency ships in vendor/npm-cache and is installed from there.
#
#   npm run setup     -> npm ci --offline (fails loudly if anything is missing)
#
# --offline is deliberate over --prefer-offline: prefer-offline silently falls
# back to the network, which works on a laptop with internet and then fails in
# CI. Fail here instead, where the message is actionable.
cache=vendor/npm-cache
offline=true
audit=false
fund=false
